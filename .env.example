# Meta webhook verification
META_VERIFY_TOKEN=replace_with_random_verify_token
META_APP_SECRET=replace_with_meta_app_secret
META_GRAPH_API_VERSION=v25.0

# Internal API authentication
AUTOMATION_API_KEY=replace_with_long_random_secret

# AI Content Generation & Smart Replies (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Facebook Page
FACEBOOK_PAGE_ID=replace_with_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_page_access_token
FACEBOOK_AUTO_REPLY_ENABLED=false

# Instagram Professional account
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace_with_instagram_professional_account_id
# Facebook Login uses graph.facebook.com and can reuse the Page token.
INSTAGRAM_GRAPH_HOST=graph.facebook.com
# Optional: separate Instagram access token overrides.
INSTAGRAM_ACCESS_TOKEN=
# Fallback token compatible with facebook_token()/instagram_token().
META_LONG_LIVED_ACCESS_TOKEN=
INSTAGRAM_AUTO_REPLY_ENABLED=false

# Google Drive image sourcing (optional). Folder URL can also be sent per request.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Durable scheduling + webhook deduplication
SCHEDULE_DB_PATH=/data/socialmediaautomation.db
SCHEDULER_ENABLED=false
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH when a volume is mounted.
# Production requires SCHEDULE_DB_PATH inside that actual mount.
SCHEDULER_POLL_SECONDS=30

ENVIRONMENT=production
PORT=8000
